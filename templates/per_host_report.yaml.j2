{% set sections = debug_report_sections if debug_report_sections != 'all' else ['inventory_info', 'group_names', 'vars', 'facts', 'environment_task', 'environment_system', 'connection_info', 'play_info', 'ansible_config'] %}
---
# Debug Output Report for {{ inventory_hostname }}
# Generated at: {{ ansible_date_time.iso8601 | default('N/A') }}
# Format: YAML (parseable by standard YAML parsers)

{% if 'inventory_info' in sections %}
inventory_info:
  inventory_hostname: {{ inventory_hostname }}
  inventory_hostname_short: {{ inventory_hostname_short }}
  inventory_dir: {{ inventory_dir | default('N/A') }}
  inventory_file: {{ inventory_file | default('N/A') }}

{% endif %}
{% if 'group_names' in sections %}
group_names: {{ group_names | to_yaml }}

{% endif %}
{% if 'vars' in sections %}
vars:
  _metadata:
    note: "Variables are dumped using ansible-inventory to avoid template evaluation issues"
    filtering:
{% if debug_include_keys | length > 0 %}
      include_keys:
{% for key in debug_include_keys %}
        - {{ key }}
{% endfor %}
{% else %}
      exclude_keys:
{% for key in debug_exclude_keys %}
        - {{ key }}
{% endfor %}
{% endif %}
{% if debug_include_patterns | length > 0 %}
      include_patterns:
{% for pattern in debug_include_patterns %}
        - {{ pattern }}
{% endfor %}
{% endif %}
{% if debug_exclude_patterns | length > 0 %}
      exclude_patterns:
{% for pattern in debug_exclude_patterns %}
        - {{ pattern }}
{% endfor %}
{% endif %}
  data:
{{ host_vars_yaml | indent(4, first=True) }}

{% endif %}
{% if 'facts' in sections %}
{% set all_facts = ansible_facts | default({}) %}
{% if debug_facts_include_keys | length > 0 %}
{# Whitelist mode: only include specified keys #}
{% set filtered_facts = {} %}
{% for key in debug_facts_include_keys %}
{% if key in all_facts %}
{% set _ = filtered_facts.update({key: all_facts[key]}) %}
{% endif %}
{% endfor %}
{% else %}
{# Blacklist mode: exclude specified keys #}
{% set filtered_facts = all_facts.copy() %}
{% for key in debug_facts_exclude_keys %}
{% if key in filtered_facts %}
{% set _ = filtered_facts.pop(key) %}
{% endif %}
{% endfor %}
{% endif %}
facts:
{{ filtered_facts | to_nice_yaml | indent(2, first=True) }}

{% endif %}
{% if 'environment_task' in sections %}
environment_task:
{{ environment | default({}) | to_nice_yaml | indent(2, first=True) }}

{% endif %}
{% if 'environment_system' in sections %}
environment_system:
{{ ansible_env | default({}) | to_nice_yaml | indent(2, first=True) }}

{% endif %}
{% if 'connection_info' in sections %}
connection_info:
  ansible_connection: {{ ansible_connection | default('N/A') }}
  ansible_host: {{ ansible_host | default('N/A') }}
  ansible_port: {{ ansible_port | default('N/A') }}
  ansible_user: {{ ansible_user | default('N/A') }}

{% endif %}
{% if 'play_info' in sections %}
play_info:
  playbook_dir: {{ playbook_dir }}
  ansible_play_hosts: {{ ansible_play_hosts | default([]) | to_yaml }}
  ansible_play_batch: {{ ansible_play_batch | default([]) | to_yaml }}
  ansible_play_hosts_all: {{ ansible_play_hosts_all | default([]) | to_yaml }}

{% endif %}
{% if 'ansible_config' in sections %}
ansible_config:
  ansible_config_file: {{ ansible_config_file | default('N/A') }}
  ansible_version: {{ ansible_version.full }}
  ansible_check_mode: {{ ansible_check_mode | default(false) }}
  ansible_diff_mode: {{ ansible_diff_mode | default(false) }}
  ansible_skip_tags: {{ ansible_skip_tags | default([]) | to_yaml }}
  ansible_run_tags: {{ ansible_run_tags | default([]) | to_yaml }}
  ansible_forks: {{ ansible_forks | default('N/A') }}
  ansible_verbosity: {{ ansible_verbosity | default(0) }}
  ansible_limit: {{ ansible_limit | default('N/A') }}

{% endif %}

